# data/ holds the content-repo clone and sync state, and skills is a symlink
# into it. Both are runtime artifacts of a deployed install and must never be
# committed to the plugin repo.
data/
/skills

# Per-install config of a deployed clone; config.example.json is the template.
/config.json

node_modules/
*.log

# The app bundle the assistant's monitor process builds from apps/*/src at
# runtime. Generated on the deployed install, never committed.
apps/*/dist/
